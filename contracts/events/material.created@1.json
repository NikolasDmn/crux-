{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crux:events/material.created@1",
  "title": "material.created v1 payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "materialRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "courseRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "fileRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9A-Z]{26}$"
    },
    "aiAllowed": {
      "type": "boolean"
    },
    "excluded": {
      "type": "boolean"
    }
  },
  "required": [
    "materialRef",
    "courseRef",
    "fileRef",
    "aiAllowed",
    "excluded"
  ]
}
