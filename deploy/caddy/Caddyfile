{
	admin off
}

{$CRUX_SITE_ADDRESS::80} {
	# Compress these types only: never text/event-stream, where a compressor would hold frames
	# back until its buffer fills (the inbox and upload streams).
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data: {$CRUX_S3_PUBLIC_ORIGIN:}; connect-src 'self' {$CRUX_S3_PUBLIC_ORIGIN:}; script-src 'self'; style-src 'self' 'unsafe-inline'"
		-Server
	}

	# The gateway is not a trust boundary: every service validates the access token itself (spec 1).
	# Internal routes are never exposed.
	# A `handle` block, not a bare `respond`: Caddy runs `handle` before `respond`, so the SPA
	# catch-all below would otherwise answer /internal/* with index.html.
	handle /internal/* {
		respond 404
	}

	# The object store, same-origin: the browser PUTs uploads and GETs downloads with pre-signed
	# URLs signed for this host (files: CRUX_S3_PUBLIC_ENDPOINT). Caddy passes the Host header
	# through unchanged, so the signature still matches at the store.
	handle /crux-files/* {
		reverse_proxy s3:8333
	}

	handle /api/v1/files/* {
		uri strip_prefix /api/v1/files
		# Server-sent events (scan/extract progress) must not sit in a buffer.
		reverse_proxy files:8080 {
			flush_interval -1
		}
	}
	handle /api/v1/ai/* {
		uri strip_prefix /api/v1/ai
		reverse_proxy ai:8080 {
			# ai may be absent (profile "ai" off): answer like an unavailable service, never hang.
			lb_try_duration 0s
		}
	}
	handle /api/v1/notify/* {
		uri strip_prefix /api/v1/notify
		# The inbox stream (SSE) must not sit in a buffer.
		reverse_proxy notify:8080 {
			flush_interval -1
		}
	}
	handle /api/v1/openapi.json {
		reverse_proxy core:8080
	}
	handle /api/v1/* {
		uri strip_prefix /api/v1
		reverse_proxy core:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
