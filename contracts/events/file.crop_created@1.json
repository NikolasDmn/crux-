{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crux:events/file.crop_created@1",
  "title": "file.crop_created v1 payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fileRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "derivedFromRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "cropBox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ]
    }
  },
  "required": [
    "fileRef",
    "derivedFromRef",
    "page",
    "cropBox"
  ]
}
