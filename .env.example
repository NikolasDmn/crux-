# Copy to .env (`make env`). Keep the real file mode 600 and out of git (spec 12).
# Every value here is a dev default; change all of them in production.

CRUX_ENV=dev
# Public origin of the app (links in emails). Behind TLS in production.
CRUX_APP_BASE_URL=http://localhost:8000
# Caddy site address: ":80" locally; your domain (e.g. crux.example.eu) in production for automatic TLS.
CRUX_SITE_ADDRESS=:80
CRUX_HTTP_PORT=8000
# Refresh cookie `Secure` flag: true in production (HTTPS), false only for plain-http local dev.
CRUX_COOKIE_SECURE=false

MYSQL_ROOT_PASSWORD=crux-root
CRUX_CORE_DB_PASSWORD=crux-core
CRUX_FILES_DB_PASSWORD=crux-files
CRUX_AI_DB_PASSWORD=crux-ai
CRUX_NOTIFY_DB_PASSWORD=crux-notify

# S3-compatible object store (SeaweedFS in dev). The store is set up from these at start.
CRUX_S3_ACCESS_KEY=crux
CRUX_S3_SECRET_KEY=crux-dev-secret

# Redis requires this password (the services' CRUX_REDIS_URL carries it).
CRUX_REDIS_PASSWORD=crux-redis-dev

# Off-site backups (scripts/backup.sh): any S3-compatible bucket, e.g. Backblaze B2 or Hetzner
# Object Storage. Empty bucket = local backups only. Use a private bucket with encryption on.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=crux/
BACKUP_KEEP_DAYS=30
# Uploads are encrypted to this age public key (age1…). Make the pair on your own machine with
# `age-keygen -o crux-backup.key` and keep that file OFF the server; restore with
# `age -d -i crux-backup.key file.age > file`. Empty = no upload (unless BACKUP_ALLOW_PLAINTEXT=1).
BACKUP_AGE_RECIPIENT=

# Shared bootstrap secret services trade for 5-minute service tokens (OPEN-QUESTIONS.md Q-arch-1).
CRUX_SERVICE_SECRET=dev-service-secret-change-me
# Envelope-encryption master key for users' AI provider keys (milestone 8). Back it up offline.
CRUX_KMS_MASTER_KEY=

# Email: dev sends to Mailpit (http://localhost:8025). Production: Postmark (B6-8), with the server
# API token as both user and password: smtp+starttls://<token>:<token>@smtp.postmarkapp.com:587
# (the From address must be a verified Postmark sender). Spec 8 dispatch interval is 30 s.
CRUX_SMTP_URL=smtp://mailpit:1025
CRUX_DISPATCH_INTERVAL_SECONDS=3

# What the gateway serves at /: the web app build (`make web`). The M1 demo console stays at /demo
# while CRUX_ENV=dev.
CRUX_WEB_DIR=../web/dist

# Notify (spec 8): keys the one-click unsubscribe links; set a long random value in production.
CRUX_UNSUBSCRIBE_SECRET=change-me
# Shared secret for the bounce/complaint webhook (empty = webhook off). In Postmark, add a Bounce
# and a Spam Complaint webhook to https://<domain>/api/v1/notify/webhooks/postmark with HTTP Basic
# auth: any user name, this secret as the password.
CRUX_EMAIL_WEBHOOK_SECRET=
