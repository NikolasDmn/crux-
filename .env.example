# Copy to .env (`make env`). Keep the real file mode 600 and out of git (spec 12).
# Every value here is a dev default; change all of them in production.

CRUX_ENV=dev
# Public origin of the app (links in emails). Behind TLS in production.
CRUX_APP_BASE_URL=http://localhost:8000
# Caddy site address: ":80" locally; your domain (e.g. crux.example.eu) in production for automatic TLS.
CRUX_SITE_ADDRESS=:80
CRUX_HTTP_PORT=8000
# Refresh cookie `Secure` flag: true in production (HTTPS), false only for plain-http local dev.
CRUX_COOKIE_SECURE=false

MYSQL_ROOT_PASSWORD=crux-root
CRUX_CORE_DB_PASSWORD=crux-core
CRUX_FILES_DB_PASSWORD=crux-files
CRUX_AI_DB_PASSWORD=crux-ai
CRUX_NOTIFY_DB_PASSWORD=crux-notify

MINIO_ROOT_USER=crux
MINIO_ROOT_PASSWORD=crux-dev-secret

# Shared bootstrap secret services trade for 5-minute service tokens (OPEN-QUESTIONS.md Q-arch-1).
CRUX_SERVICE_SECRET=dev-service-secret-change-me
# Envelope-encryption master key for users' AI provider keys (milestone 8). Back it up offline.
CRUX_KMS_MASTER_KEY=
