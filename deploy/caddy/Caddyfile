{
	admin off
}

{$CRUX_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data: {$CRUX_MINIO_PUBLIC_ORIGIN:}; connect-src 'self' {$CRUX_MINIO_PUBLIC_ORIGIN:}; script-src 'self'; style-src 'self' 'unsafe-inline'"
		-Server
	}

	# The gateway is not a trust boundary: every service validates the access token itself (spec 1).
	# Internal routes are never exposed.
	@internal path /internal/*
	respond @internal 404

	handle /api/v1/files/* {
		uri strip_prefix /api/v1/files
		reverse_proxy files:8080
	}
	handle /api/v1/ai/* {
		uri strip_prefix /api/v1/ai
		reverse_proxy ai:8080 {
			# ai may be absent (profile "ai" off): answer like an unavailable service, never hang.
			lb_try_duration 0s
		}
	}
	handle /api/v1/notify/* {
		uri strip_prefix /api/v1/notify
		reverse_proxy notify:8080
	}
	handle /api/v1/openapi.json {
		reverse_proxy core:8080
	}
	handle /api/v1/* {
		uri strip_prefix /api/v1
		reverse_proxy core:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
