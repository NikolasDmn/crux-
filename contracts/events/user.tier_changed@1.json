{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crux:events/user.tier_changed@1",
  "title": "user.tier_changed v1 payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "userRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "tierCode": {
      "type": "string"
    },
    "storageQuotaBytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "userRef",
    "tierCode",
    "storageQuotaBytes"
  ]
}
