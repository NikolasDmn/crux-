{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crux:events/file.purged@1",
  "title": "file.purged v1 payload",
  "description": "files → core: the original object is gone; text, crops and thumbnails stay (spec 6.2).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fileRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purgedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "fileRef",
    "ownerRef",
    "sha256"
  ]
}
